{
  "manifest_version": 3,
  "name": "VK Tracklist Export + inj",
  "version": "1.0.0",
  "description": "Exports VK playlist track lists and sends them to the local Revseeker web app.",
  "key": "",
  "permissions": ["scripting", "tabs", "downloads", "alarms"],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VK Tracklist Export"
  },

  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://vk.ru/*"],
      "js": ["content_vk.js"],
      "run_at": "document_idle"
    }
  ]
}